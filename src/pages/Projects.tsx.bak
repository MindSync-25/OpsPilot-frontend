import { useState } from 'react'
import { Plus } from 'lucide-react'
import Kanban, { type KanbanTask } from '@/components/kanban/Kanban'
import PageHeader from '@/components/common/PageHeader'
import ContentSection from '@/components/common/ContentSection'
import { Button } from '@/components/ui/button'

const initialTasks: KanbanTask[] = [
  {
    id: '1',
    title: 'Setup development environment',
    description: 'Install dependencies and configure development tools',
    status: 'done',
    priority: 'high',
    assignee: 'John',
    dueDate: 'Jan 15',
  },
  {
    id: '2',
    title: 'Design database schema',
    description: 'Create ERD and define table relationships',
    status: 'done',
    priority: 'medium',
    assignee: 'Sarah',
    dueDate: 'Jan 18',
  },
  {
    id: '3',
    title: 'Implement authentication',
    description: 'Add login and registration functionality',
    status: 'in_progress',
    priority: 'high',
    assignee: 'Mike',
    dueDate: 'Jan 22',
  },
  {
    id: '4',
    title: 'Build API endpoints',
    description: 'Create REST API for core features',
    status: 'in_progress',
    priority: 'medium',
    assignee: 'John',
    dueDate: 'Jan 25',
  },
  {
    id: '5',
    title: 'Create admin dashboard',
    description: 'Build UI for administrative functions',
    status: 'todo',
    priority: 'medium',
    assignee: 'Sarah',
    dueDate: 'Jan 28',
  },
  {
    id: '6',
    title: 'Write unit tests',
    description: 'Add test coverage for critical components',
    status: 'todo',
    priority: 'low',
    assignee: 'Mike',
    dueDate: 'Feb 2',
  },
  {
    id: '7',
    title: 'Deploy to staging',
    description: 'Setup CI/CD pipeline and deploy to staging server',
    status: 'todo',
    priority: 'high',
    assignee: 'John',
    dueDate: 'Feb 5',
  },
]

export default function Projects() {
  const [tasks, setTasks] = useState<KanbanTask[]>(initialTasks)
  const [showNewTaskForm, setShowNewTaskForm] = useState(false)
  const [newTaskTitle, setNewTaskTitle] = useState('')
  const [newTaskDescription, setNewTaskDescription] = useState('')

  const handleTaskMove = (taskId: string, newStatus: 'todo' | 'in_progress' | 'done') => {
    setTasks((prevTasks) =>
      prevTasks.map((task) =>
        task.id === taskId ? { ...task, status: newStatus } : task
      )
    )
  }

  const handleAddTask = (e: React.FormEvent) => {
    e.preventDefault()

    if (!newTaskTitle.trim()) return

    const newTask: KanbanTask = {
      id: Date.now().toString(),
      title: newTaskTitle,
      description: newTaskDescription,
      status: 'todo',
      priority: 'medium',
    }

    setTasks([...tasks, newTask])
    setNewTaskTitle('')
    setNewTaskDescription('')
    setShowNewTaskForm(false)
  }

  return (
    <ContentSection>
      <PageHeader
        title="Projects"
        subtitle="Manage your project tasks using the Kanban board"
        primaryAction={
          <Button onClick={() => setShowNewTaskForm(!showNewTaskForm)}>
            <Plus className="w-5 h-5 mr-2" />
            New Task
          </Button>
        }
      />

      {/* New task form */}
      {showNewTaskForm && (
        <div className="bg-card rounded-lg border border-border p-6">
          <h3 className="text-lg font-medium mb-4">
            Create New Task
          </h3>
          <form onSubmit={handleAddTask} className="space-y-4">
            <div>
              <label
                htmlFor="title"
                className="block text-sm font-medium mb-2"
              >
                Title
              </label>
              <input
                type="text"
                id="title"
                value={newTaskTitle}
                onChange={(e) => setNewTaskTitle(e.target.value)}
                className="w-full px-3 py-2 border border-input rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-ring text-sm"
                placeholder="Enter task title"
                required
              />
            </div>
            <div>
              <label
                htmlFor="description"
                className="block text-sm font-medium mb-2"
              >
                Description
              </label>
              <textarea
                id="description"
                rows={3}
                value={newTaskDescription}
                onChange={(e) => setNewTaskDescription(e.target.value)}
                className="w-full px-3 py-2 border border-input rounded-md bg-background focus:outline-none focus:ring-2 focus:ring-ring text-sm"
                placeholder="Enter task description"
              />
            </div>
            <div className="flex justify-end space-x-3">
              <Button
                type="button"
                variant="outline"
                onClick={() => setShowNewTaskForm(false)}
              >
                Cancel
              </Button>
              <Button type="submit">
                Create Task
              </Button>
            </div>
          </form>
        </div>
      )}

      {/* Kanban Board */}
      <Kanban tasks={tasks} onTaskMove={handleTaskMove} />
    </ContentSection>
  )
}
